{
  "version": 1,
  "approval": "ask",
  "servers": [
    {
      "name": "fs",
      "command": "uvx",
      "args": [
        "--from",
        "filesystem-mcp",
        "filesystem-mcp",
        "${MCP_FS_ROOT}"
      ],
      "required": false,
      "allow": [
        "read_file",
        "list_directory",
        "list_allowed_directories"
      ],
      "approval": {
        "list_allowed_directories": "allow",
        "list_directory": "ask",
        "read_file": "ask"
      },
      "descriptions": {
        "list_allowed_directories": "Показать каталоги, разрешённые filesystem-серверу",
        "list_directory": "Показать файлы и подкаталоги в разрешённом каталоге",
        "read_file": "Прочитать текстовый файл внутри разрешённого каталога"
      },
      "rules": {
        "read_file": {
          "path_under": "${MCP_FS_ROOT}"
        },
        "list_directory": {
          "path_under": "${MCP_FS_ROOT}"
        }
      }
    },
    {
      "name": "web",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "required": false,
      "allow": [
        "fetch"
      ],
      "approval": {
        "fetch": "ask"
      },
      "descriptions": {
        "fetch": "Загрузить URL из интернета; домен проверяется правилом url_hosts"
      },
      "rules": {
        "fetch": {
          "url_hosts": [
            "*"
          ]
        }
      }
    },
    {
      "name": "rates",
      "command": "./bin/mcp-cbr",
      "args": [],
      "required": false,
      "allow": [
        "currency_rate"
      ],
      "approval": {
        "currency_rate": "ask"
      },
      "descriptions": {
        "currency_rate": "Курс валюты ЦБ РФ на дату. Аргументы: currency (USD, EUR, CNY, ...), date (ДД.ММ.ГГГГ или пусто — сегодня)."
      }
    },
    {
      "name": "forex",
      "command": "./bin/mcp-forex",
      "args": [],
      "required": false,
      "env": {
        "FOREX_STORE": "${FOREX_STORE}"
      },
      "allow": [
        "fetch_fx",
        "save_tick",
        "read_period"
      ],
      "approval": {
        "fetch_fx": "allow",
        "save_tick": "ask",
        "read_period": "allow"
      },
      "descriptions": {
        "fetch_fx": "Текущий spot-курс валютной пары (Coinbase). Аргументы base и quote, по умолчанию USD/RUB.",
        "save_tick": "Сохранить замер курса в append-only JSONL-журнал; возвращает общее число записей.",
        "read_period": "Прочитать накопленные замеры за период [from, to], с фильтром по quote."
      }
    }
  ]
}
